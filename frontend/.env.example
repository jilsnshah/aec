# Copy to .env and adjust. No real secrets belong in this file.

# Base URL of the backend API. Leave empty: the app calls /api on its own
# origin (in development the Vite server forwards it to API_PROXY_TARGET).
VITE_API_BASE_URL=
API_PROXY_TARGET=http://localhost:8000

# Port the Vite dev server listens on.
VITE_PORT=5173

# Currency for displayed amounts (ISO 4217).
VITE_CURRENCY=INR
