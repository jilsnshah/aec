# Copy to .env and adjust. No real secrets belong in this file.

# PostgreSQL is required. The inventory rules depend on row-level locking, so
# the application refuses to start against any other database.
# `docker compose up -d db` creates a local server matching these credentials.
DATABASE_URL=postgresql+psycopg://aec:aec_dev_password@localhost:5432/aec

# Where the test suite creates its per-test schemas. Falls back to DATABASE_URL.
# TEST_DATABASE_URL=postgresql+psycopg://aec:aec_dev_password@localhost:5432/aec_test

ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Daily dashboard figures start at local midnight in this IANA zone.
BUSINESS_TIMEZONE=Asia/Kolkata

# Connection pool. Size DB_POOL_SIZE x processes against PostgreSQL's
# max_connections, leaving headroom for migrations and admin sessions.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Server-side safety nets, in milliseconds. 0 disables either one.
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=10000

# Allow a sales line to be discounted to a price of zero (a free item).
ALLOW_ZERO_PRICE_LINES=true

# Echo every SQL statement to the log. Noisy; off by default.
SQL_ECHO=false
